{
  "name": "pipkins",
  "version": "0.1.0",
  "description": "Deterministic animal avatars that breed and fuse. Zero dependencies.",
  "homepage": "https://github.com/Michaell14/pipkins#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Michaell14/pipkins.git"
  },
  "bugs": {
    "url": "https://github.com/Michaell14/pipkins/issues"
  },
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./types/index.d.ts",
  "unpkg": "./dist/pipkins.min.js",
  "jsdelivr": "./dist/pipkins.min.js",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./motion.css": "./src/motion.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "types",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/pipkin.test.js",
    "build": "node scripts/build.mjs",
    "golden": "node scripts/golden.mjs",
    "og": "node scripts/og.mjs",
    "prepublishOnly": "npm test && npm run build"
  },
  "keywords": [
    "avatar",
    "identicon",
    "deterministic",
    "svg",
    "generative",
    "animal",
    "pipkins",
    "pipkin"
  ],
  "license": "MIT",
  "devDependencies": {
    "esbuild": "0.24.0"
  }
}
